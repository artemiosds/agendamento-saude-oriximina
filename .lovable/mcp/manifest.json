{
  "version": 1,
  "sdk_version": "2.1.0",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://ygbgywglxsshkkoiriul.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "agendamento-saude-oriximina",
      "version": "0.1.0",
      "title": "AGENDAMENTO SAÚDE ORIXIMINÁ"
    },
    "tools": [
      {
        "name": "search_patients",
        "title": "Buscar pacientes",
        "description": "Busca pacientes pelo nome dentro da unidade permitida ao usuário conectado.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 2,
              "maxLength": 120,
              "description": "Nome ou parte do nome do paciente."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20,
              "default": 10,
              "description": "Máximo de resultados."
            }
          },
          "required": [
            "name"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_daily_agenda",
        "title": "Consultar agenda diária",
        "description": "Lista os agendamentos de uma data dentro da unidade permitida ao usuário conectado.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Data no formato AAAA-MM-DD."
            },
            "professional_id": {
              "type": "string",
              "format": "uuid",
              "description": "ID opcional do profissional."
            }
          },
          "required": [
            "date"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_patient_appointments",
        "title": "Consultar histórico de agendamentos",
        "description": "Consulta os agendamentos recentes de um paciente dentro da unidade permitida.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "patient_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "description": "ID do paciente retornado pela busca."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 10,
              "description": "Máximo de agendamentos."
            }
          },
          "required": [
            "patient_id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
