{
  "version": 1,
  "sdk_version": "2.1.0",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://ygbgywglxsshkkoiriul.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "agendamento-saude-oriximina",
      "version": "0.1.0",
      "title": "AGENDAMENTO SAÚDE ORIXIMINÁ"
    },
    "tools": [
      {
        "name": "search_patients",
        "title": "Buscar pacientes",
        "description": "Busca pacientes pelo nome dentro da unidade permitida ao usuário conectado.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 2,
              "maxLength": 120,
              "description": "Nome ou parte do nome do paciente."
            },
            "limit": {
              "default": 10,
              "description": "Máximo de resultados.",
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            }
          },
          "required": [
            "name"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "get_daily_agenda",
        "title": "Consultar agenda diária",
        "description": "Lista os agendamentos de uma data dentro da unidade permitida ao usuário conectado.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Data no formato AAAA-MM-DD."
            },
            "professional_id": {
              "description": "ID opcional do profissional.",
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          },
          "required": [
            "date"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "get_patient_appointments",
        "title": "Consultar histórico de agendamentos",
        "description": "Consulta os agendamentos recentes de um paciente dentro da unidade permitida.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "patient_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "description": "ID do paciente retornado pela busca."
            },
            "limit": {
              "default": 10,
              "description": "Máximo de agendamentos.",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          },
          "required": [
            "patient_id"
          ]
        },
        "outputSchema": null
      }
    ]
  }
}
